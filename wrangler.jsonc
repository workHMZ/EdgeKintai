{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edge-kintai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],

  // Static files bypass the Worker and therefore do not consume dynamic
  // Workers Free requests. Only API paths invoke the Worker first.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "DEFAULT_BREAK_MINUTES": "60",
    "DEFAULT_ONE_WAY_FARE": "210",
    "DEFAULT_TRIP_TYPE": "round_trip",
    "OVERTIME_THRESHOLD_HOURS": "180",
    "SESSION_TTL_SECONDS": "604800"
  },

  "secrets": {
    "required": ["SETUP_TOKEN"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edge-kintai-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2316401101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],

  // Monday 03:00 JST (Sunday 18:00 UTC): refresh the official holiday cache.
  "triggers": {
    "crons": ["0 18 * * 1"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
