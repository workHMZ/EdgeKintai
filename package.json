{
  "name": "edge-kintai",
  "version": "2.8.0",
  "description": "Cloudflare-native attendance tracker for Japan",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/workHMZ/EdgeKintai.git"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run cf-typegen && npm run typecheck",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy:cf": "node scripts/deploy-cloudflare.mjs",
    "deploy:cf:check": "node --check scripts/deploy-cloudflare.mjs && node scripts/deploy-cloudflare.mjs --check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false --strict-vars=false --env-file .dev.vars.example",
    "cf-typegen:check": "npm run cf-typegen -- --check",
    "typecheck": "tsc --noEmit",
    "lint:frontend": "eslint public/app.js public/excel.js",
    "test:excel": "node scripts/test-excel.mjs",
    "test:ui": "node scripts/test-ui-contract.mjs",
    "test": "vitest run",
    "verify": "npm run build && npm run cf-typegen:check && npm run deploy:cf:check && npm run lint:frontend && npm run test:ui && npm run test:excel && npm test"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Required one-time bootstrap secret. Generate with: openssl rand -hex 32"
      }
    }
  }
}
